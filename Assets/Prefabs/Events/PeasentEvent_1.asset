  title: Sickness spreads
  description: 'A sickness is spreading through the lower population. Medicine stocks
    are dwindling. Work piles up. The people ask you what to do. '
  isKingEvent: 0
  choices:
  - choiceText: 'Quarantine the sick - even when their crops are lost. '
    consequences:
    - type: 1
      amount: -5
    - type: 3
      amount: -5
  - choiceText: 'The situation is dire, the kingdom needs food. No rest for the wicked. '
    consequences:
    - type: 1
      amount: 5
    - type: 3
      amount: -15
  - choiceText: 'Distribute the medicine among the sick, and hope they pay their
      taxes well. '
    consequences:
    - type: 0
      amount: -15
