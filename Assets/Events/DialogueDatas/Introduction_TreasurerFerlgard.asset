  title: Introduction Treasurer Ferlgard
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 77e34f3f565e26f48b06edcdbba01974, type: 2}
    dialogueLines:
    - line: 'Are you the Advisor? '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Who''s asking? '
        responseToChoice: 'I made time in my busy schedule to introduce myself. '
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'I suppose so, and you are? '
        responseToChoice: 'Good, because I made time in my busy schedule to introduce
          myself. '
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'I am the royal treasurer - handling all things expenses, incomes, and
        coins. '
      choices: []
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'My name is Ferlgard, and I hope we can make plenty of financially benefical
        decisions together. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Pleasure to meet, Ferlgard. '
        responseToChoice: 'Yes. '
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Let''s fill the king''s chamber with everything gold. '
        responseToChoice: 'I am glad you understand me. '
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 1
      nextSpeakerID: -1
