  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: Dia_King_Trade route offer
  m_EditorClassIdentifier: 
  title: 
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 77e34f3f565e26f48b06edcdbba01974, type: 2}
    dialogueLines:
    - line: 'I have come with an offer today, Advisor. One of our neighbours, the
        country of Linzar, want to establish a trade route. This could bring us regularly
        money - or lose it. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: We will take the risk and establish a trade route. Trading is
          better than waging war.
        responseToChoice: I agree - I will set up the logistics.
        consequences:
        - type: 0
          amount: -150
        - type: 1
          amount: 15
        dailyChanges: []
        receivingVaribale: {fileID: 11400000, guid: f839cc5d459f8804ba318c070fc6674a, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: I would not like to lose coins because of another countries failures
          - we will not establisht the route.
        responseToChoice: If you say so - I will tell them.
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
