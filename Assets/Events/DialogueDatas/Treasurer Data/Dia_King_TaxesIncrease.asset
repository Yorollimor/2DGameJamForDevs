MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: Dia_King_TaxesIncrease
  m_EditorClassIdentifier: 
  title: Taxes Increase
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 77e34f3f565e26f48b06edcdbba01974, type: 2}
    dialogueLines:
    - line: 'The Kingdom is in need of coins, Advisor. Don''t you think so? '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'I suppose so. '
        responseToChoice: Yes so...
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Is the King not rich enough? '
        responseToChoice: A King can never be too rich. So...
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: -1
    - line: 'What do you recommend, Advisor? '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Increase the taxes of the peasants. '
        responseToChoice: 'Yes, that seems reasonable. '
        consequences:
        - type: 6
          amount: -25
        dailyChanges:
        - type: 0
          amount: 5
        - type: 3
          amount: -1
        receivingVaribale: {fileID: 11400000, guid: 13c7b8c5462a67f438bb93c2f06a4ae5, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'We should see to get rid of some extra guards then. '
        responseToChoice: 'The guards, you say? They won''t be happy to lose their
          jobs, but alas. '
        consequences:
        - type: 2
          amount: -15
        - type: 1
          amount: -10
        - type: 6
          amount: -5
        dailyChanges:
        - type: 0
          amount: 2
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'I think they are good as they are at the moment. '
        responseToChoice: 'You think so, eh? Well then. '
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 1
      nextSpeakerID: -1
