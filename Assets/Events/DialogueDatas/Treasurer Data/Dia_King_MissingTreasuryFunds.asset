  - speaker: {fileID: 11400000, guid: 77e34f3f565e26f48b06edcdbba01974, type: 2}
    dialogueLines:
    - line: Advisor, it has come to my attention that gold is missing from the treasury
        - without me knowing. We might have a thief going around.
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: We can handle missing some coins. Ignore it.
        responseToChoice: Every coin is important - but alright.
        consequences:
        - type: 0
          amount: -10
        - type: 1
          amount: -15
        dailyChanges: []
        receivingVaribale: {fileID: 11400000, guid: eb47e5e8e725a0e4eaf3dc97c78d5c79, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: Invest in finding that petty thief and our gold.
        responseToChoice: Yes, good decision.
