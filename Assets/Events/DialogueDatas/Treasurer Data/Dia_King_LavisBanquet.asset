  - speaker: {fileID: 11400000, guid: 77e34f3f565e26f48b06edcdbba01974, type: 2}
    dialogueLines:
    - line: 'Some extravagant nobles want to hold a lavish banquet on the market
        square - this would cost significantly and most likely anger some people. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: Let them have their banquet - we can handle the consequences.
        responseToChoice: 'If you say so. '
        consequences:
        - type: 0
          amount: -150
        - type: 1
          amount: 25
        - type: 6
          amount: -15
        dailyChanges: []
        receivingVaribale: {fileID: 11400000, guid: 6d5f81fccf8f84a4bacff6034a208c76, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: We do not have the resources to hold this banquet.
        responseToChoice: 'I agree - I will tell them their request is denied. '
        consequences:
        - type: 1
          amount: -35
        - type: 6
          amount: 10
