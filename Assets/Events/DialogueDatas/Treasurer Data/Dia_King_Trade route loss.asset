        receivingVaribale: {fileID: 0}
        removingVariable: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: Yes - that is enough. End the agreement.
        responseToChoice: I will do so.
