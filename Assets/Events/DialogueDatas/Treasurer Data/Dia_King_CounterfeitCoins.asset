  title: 
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 77e34f3f565e26f48b06edcdbba01974, type: 2}
    dialogueLines:
    - line: 'Advisor, it seems some coins have been found to be counterfeits - we
        do not know where they came from, but we know how to find them. I recommend
        melting those false coins and replacing them with real ones. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'I agree - replace them. '
        responseToChoice: 'I will start immediately. '
        consequences:
        - type: 0
          amount: -100
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Let''s keep them and add them to the treasury. '
        responseToChoice: 'My stomach curls thinking of doing that, but alright. '
        consequences:
        - type: 0
          amount: 100
        - type: 1
          amount: -15
        dailyChanges: []
        receivingVaribale: {fileID: 0}
