  title: Syndicate reveals itself
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 5a6f24257be70fb4faf4193faac70975, type: 2}
    dialogueLines:
    - line: 'Big news Advisor. Those "petty crimes" and the recent surge of them?
        A group just admitted to be the reason for them - that they are planning
        something big. We need to stop this "Syndicate" as they seem to call it -
        now. '
      choices:
      - conditionToShow: {fileID: 0}
        choiceText: 'Alright, this seems serious now. I will allow any resources
          necessary to find those criminals and their plans. '
        responseToChoice: 'Good. '
        consequences:
        - type: 0
          amount: -350
        - type: 1
          amount: -20
