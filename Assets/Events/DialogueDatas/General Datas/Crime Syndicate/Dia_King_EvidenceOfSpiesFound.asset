  title: Found evidence for spies in own ranks
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 5a6f24257be70fb4faf4193faac70975, type: 2}
    dialogueLines:
    - line: Advisor, I come to see you with urgent matters - my men found evidence
        that some of the new recruits are part of the Syndicate.
      choices: []
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'We need to find and deal with them swiftly - or the King can not be
        safe. '
      choices:
      - conditionToShow: {fileID: 0}
        choiceText: 'Your men did good. Pay them well so they find each and everyone
          of them. '
        responseToChoice: 'Yes, Advisor, they will not hide long between us anymore. '
