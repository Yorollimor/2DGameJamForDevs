MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: DIa_King_TrailsOfCorruptGuards
  m_EditorClassIdentifier: 
  title: Found evidence for corrupt guards
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 5a6f24257be70fb4faf4193faac70975, type: 2}
    dialogueLines:
    - line: 'Advisor, this is of highest importance. The men I sent out to make sure
        the band of criminals is gone for good, found one of their hideouts. '
      choices:
      - conditionToShow: {fileID: 0}
        choiceText: What did they find?
        responseToChoice: 'They found plans to infiltrate our ranks with corrupt
          soldiers. '
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
    - line: '... And a plan to murder the King. '
      choices:
      - conditionToShow: {fileID: 0}
        choiceText: The King?! By all means, put some extra guards to him and confine
          him to his room for now!
        responseToChoice: 'I hope that is wise. '
        consequences:
        - type: 0
          amount: -50
        - type: 1
          amount: 5
        dailyChanges: []
        receivingVaribale: {fileID: 11400000, guid: 6b91adae9bc165c4b88ce9550340fc57, type: 2}
      - conditionToShow: {fileID: 0}
        choiceText: 'We need to find the traitors first before acting - use whatever
          resources you need. '
        responseToChoice: 'Yes, advisor. They will not hide much longer. '
        consequences:
        - type: 0
          amount: -350
        - type: 2
          amount: -10
        - type: 6
          amount: 15
        dailyChanges: []
        receivingVaribale: {fileID: 11400000, guid: 7d2494ac66d362146a5e402dfa1b7936, type: 2}
      isFinalLine: 0
      nextSpeakerID: 0
