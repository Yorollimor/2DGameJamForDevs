  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: Dia_King_NeighborIncreasesArmySIze
  m_EditorClassIdentifier: 
  title: Neigbouring Kingdom recruits bigger army
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 5a6f24257be70fb4faf4193faac70975, type: 2}
    dialogueLines:
    - line: 'Advisor, my scouts have found something of concern. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'What is it? '
        responseToChoice: The kingdom of Venna, our neighbours, seem to put massive
          efforts into recruiting new soldiers.
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'We are not sure if it means something, but we could also invest in new
        soldiers to be prepared for the worst. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'I agree, let''s be cautious and recruit new blood for the worst
          case. '
        responseToChoice: 'Good, I will get right to it. '
        consequences:
        - type: 0
          amount: -200
        - type: 1
          amount: 15
        dailyChanges:
        - type: 2
          amount: 5
        receivingVaribale: {fileID: 11400000, guid: 499e4551c3bcd754ca014bf57d3906f0, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: I wouldn't panic because of some so-far-friendly neighbour seeing
          to their own defenses. Keep an eye on them however.
        responseToChoice: 'Understood. '
        consequences:
        - type: 1
          amount: 5
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 1
      nextSpeakerID: 0
    - line: I will keep you informed if there are any other movements from them.
      choices: []
      isFinalLine: 1
      nextSpeakerID: 0
