MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: Dia_King_NeighbourMarchesTowardsUs
  m_EditorClassIdentifier: 
  title: Neighbouring kingdom marches towards us
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 5a6f24257be70fb4faf4193faac70975, type: 2}
    dialogueLines:
    - line: 'Advisor, concerning news. The kingdom of Venna was seen to be marching
        towards our borders. No formal declaration of war has been given, but it
        is still concerning. '
      choices: []
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'I would suggest to wait and - if they want a battle - do it on our own
        land, to our advantages. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'I agree let''s not be hasty, there is no reason for them to
          attack us. We wait and see, but get your men into shape. '
        responseToChoice: 'They will be ready. '
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 11400000, guid: daeb17ed7d754fa4e913129288bebf5e, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: This seems too dangerous - I suggest we attack them preemptively
          to not give them the chance to ready themselves more.
        responseToChoice: 'I understand that decision - My men will crush their efforts. '
        consequences:
        - type: 1
          amount: 25
        dailyChanges: []
        receivingVaribale: {fileID: 11400000, guid: 2fb3ffd4375103b46929966d7baedffe, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 11400000, guid: 499e4551c3bcd754ca014bf57d3906f0, type: 2}
        choiceText: 'I think now is the time to increase our own recruiting efforts.
          See to it that we gain new recruits quick. '
        responseToChoice: 'Yes, that seems reasonable. I will find some fresh blood
          for our ranks. '
        consequences:
        - type: 1
          amount: 15
        - type: 0
          amount: -250
        dailyChanges:
        - type: 2
          amount: 5
        receivingVaribale: {fileID: 11400000, guid: daeb17ed7d754fa4e913129288bebf5e, type: 2}
      isFinalLine: 1
      nextSpeakerID: 0
