  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: Dia_King_AfterPreemptiveAttack
  m_EditorClassIdentifier: 
  title: Preemptive attack
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 5a6f24257be70fb4faf4193faac70975, type: 2}
    dialogueLines:
    - line: 'Advisor, the battle with Venna is done. We have lost quiet some number
        of men, but Venna''s army is crushed and they will not be able to threaten
        us anymore. '
      choices: []
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'Further, it seemed that they did plan to invade us as some of their
        dying screams suggested - so the decision was not entirely wrong. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Thank you for the report, General. '
        responseToChoice: 'Of course. Let''s hope this also works as a reminder for
          our other neighbours to not underestimate our power. '
        consequences:
        - type: 2
          amount: -25
        - type: 1
          amount: 15
        - type: 6
          amount: -5
        dailyChanges:
        - type: 2
          amount: -4
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
