  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 5a6f24257be70fb4faf4193faac70975, type: 2}
    dialogueLines:
    - line: ...
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'What is it, General? '
        responseToChoice: I am ashamed to say this, but...
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'One of my men was caught stealing ham from the pantry and... I am unsure
        what to do. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'We can not tolerate behavior like this from our soldiers, the
          enforcers of law and protectors of the kingdom. He needs to be hanged. '
        responseToChoice: 'Hanged?! But... but yes, you have a valid point. I will
          see to it. '
        consequences:
        - type: 6
          amount: -15
        - type: 1
          amount: 15
        - type: 2
          amount: -1
        dailyChanges:
        - type: 2
          amount: -1
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Stealing from the food storage is a criminal offense. Fire him. '
        responseToChoice: 'Yes, I understand. '
        consequences:
        - type: 6
          amount: -5
        - type: 2
          amount: -1
        - type: 1
          amount: 5
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'If our soldiers need food so desperately, we shall provide them
          with extra rations today. '
        responseToChoice: 'That will be appreciated, Advisor. '
        consequences:
        - type: 6
          amount: 15
        - type: 3
          amount: -100
        - type: 6
          amount: 20
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 1
