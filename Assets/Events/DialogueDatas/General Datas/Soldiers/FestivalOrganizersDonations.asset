  title: 
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 5a6f24257be70fb4faf4193faac70975, type: 2}
    dialogueLines:
    - line: 'Advisor, I have spoken with some organizers for the fighting festival
        - they say to make the festival "really great" they are in need of more donations.
        What do you think? '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'We do not have the resources to spend more on this - they should
          do their best with the coins they got. '
        responseToChoice: 'Yes, I will bring them that message. '
        consequences:
        - type: 0
          amount: 0
        dailyChanges: []
        receivingVaribale: {fileID: 11400000, guid: 223493ffa6be4504daee021b6d55a53c, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Alright, let''s hope this "really great" festival is worth it.
          I will allow more finances to flow into this. '
        responseToChoice: 'I am looking forward to it. '
        consequences:
        - type: 0
          amount: -350
        - type: 6
          amount: 15
        dailyChanges: []
        receivingVaribale: {fileID: 11400000, guid: b9d5d7479c39c744f9162178b21eb3aa, type: 2}
