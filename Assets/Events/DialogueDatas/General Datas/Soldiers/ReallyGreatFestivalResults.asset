  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 5a6f24257be70fb4faf4193faac70975, type: 2}
    dialogueLines:
    - line: 'I come with great news - the fighting festival was an absolute success
        - financially, and with my men. The orgnizers were not lying about making
        it "really great" with those extra donations. '
      choices: []
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'We already got some new recruits thanks to it, and the general interest
        in joining the army increased as well. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Wonderful - thank you for the report, General. '
        responseToChoice: 'I have to thank, Advisor! Good day. '
