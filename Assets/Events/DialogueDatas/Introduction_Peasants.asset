  title: Introduction Peasants
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 9f9aada79e4b64c4e9df2ba49fcc84f7, type: 2}
    dialogueLines:
    - line: 'Greetings, it was rumored that we should come to you to tell you our
        problems? '
      choices:
      - conditionToShow: {fileID: 0}
        choiceText: 'I am the kingdom''s advisor, so, yes. '
        responseToChoice: Wonderful.
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'I was elected as the voice of our people here, please, call me Landil. '
      choices:
      - conditionToShow: {fileID: 0}
        choiceText: 'Landil, nice to meet you. '
        responseToChoice: 'Likewise. '
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        choiceText: 'I do not care about your names, peasant. '
        responseToChoice: '... of course. '
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 11400000, guid: e028f00b60425bd42ae5b426a3b49821, type: 2}
