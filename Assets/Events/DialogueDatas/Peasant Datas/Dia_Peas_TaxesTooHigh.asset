  title: Taxes too high
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 9f9aada79e4b64c4e9df2ba49fcc84f7, type: 2}
    dialogueLines:
    - line: 'The taxes are too high, Advisor! We can barely buy food for ourselves. '
      choices: []
      isFinalLine: 0
      nextSpeakerID: 0
    - line: Please, do something!
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'I am sorry, but the Kingdom has expenses to pay. '
        responseToChoice: Damn the Kingdom...
        consequences:
        - type: 6
          amount: -15
        - type: 5
          amount: -25
        dailyChanges:
        - type: 3
          amount: -2
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: I understand. I will tell them to lower them.
        responseToChoice: Thank you!
        consequences:
        - type: 6
          amount: 5
        dailyChanges:
        - type: 0
          amount: -3
        - type: 3
          amount: 1
        receivingVaribale: {fileID: 0}
