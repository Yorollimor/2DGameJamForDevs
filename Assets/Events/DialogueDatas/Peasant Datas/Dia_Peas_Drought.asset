--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: Dia_Peas_Drought
  m_EditorClassIdentifier: 
  title: Drought
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 9f9aada79e4b64c4e9df2ba49fcc84f7, type: 2}
    dialogueLines:
    - line: 'Ser Advisor, the recent heatwaves have made it dangerous to work in
        the field - but the crops are drying out and need to be harvested. '
      choices: []
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'Further, those that have been pushing themselves became sick. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: Transport water on the fields by hand - the kingdom needs food.
        responseToChoice: 'That will kill us. '
        consequences:
        - type: 3
          amount: -25
        - type: 5
          amount: -15
        - type: 6
          amount: -25
        dailyChanges:
        - type: 3
          amount: -2
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Let your people rest, the kingdom will be okay. '
        responseToChoice: 'Thank you, and I hope so. '
        consequences:
        - type: 6
          amount: 15
        - type: 3
          amount: -50
        dailyChanges:
        - type: 1
          amount: -3
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: I will arrange that your people get medicine so they can recover
          swiftly and work again.
        responseToChoice: 'Thank you so much. '
        consequences:
        - type: 3
          amount: -10
        - type: 6
          amount: 20
        - type: 0
          amount: -100
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 1
      nextSpeakerID: -1
