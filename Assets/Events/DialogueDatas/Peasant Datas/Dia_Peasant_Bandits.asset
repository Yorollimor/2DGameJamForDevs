  title: 
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 9f9aada79e4b64c4e9df2ba49fcc84f7, type: 2}
    dialogueLines:
    - line: 'Ser Advisor, we have had raids by a small bandit group recently - they
        are stealing food and scaring the people. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: I will ask that some soldiers take care of them.
        responseToChoice: 'Thank you, hopefully we can sleep in peace soon again. '
        consequences:
        - type: 2
          amount: -15
        - type: 6
          amount: 10
        - type: 3
          amount: -50
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: I recommend hiding and letting them pass - no good by provoking
          them. The food storages can handle it.
        responseToChoice: 'I hope you are right. '
        consequences:
        - type: 6
          amount: -10
        - type: 3
          amount: -50
        dailyChanges: []
        receivingVaribale: {fileID: 11400000, guid: f5a12280b617ed1459c549b63f8574a5, type: 2}
      isFinalLine: 0
      nextSpeakerID: 0
