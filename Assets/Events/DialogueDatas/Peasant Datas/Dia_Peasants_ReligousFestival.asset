  title: 
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 9f9aada79e4b64c4e9df2ba49fcc84f7, type: 2}
    dialogueLines:
    - line: 'Ser, a part of my people have a traditional holiday and festival coming
        up - they are asking if they might take some days off to celebrate it properly. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'They shall celebrate their festival to their heart''s contents. '
        responseToChoice: 'Wonderful, we appreciate your support. '
        consequences:
        - type: 6
          amount: 10
        - type: 5
          amount: 15
        dailyChanges:
        - type: 1
          amount: -1
        receivingVaribale: {fileID: 11400000, guid: 5efbbd3af4b13714b8fb685bbc4a4c46, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'We do not have the luxury to miss out on their work. '
        responseToChoice: 'I understand - I hope they will too. '
        consequences:
        - type: 6
          amount: -15
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
