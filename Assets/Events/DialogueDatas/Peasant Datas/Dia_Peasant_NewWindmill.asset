  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: Dia_Peasant_NewWindmill
  m_EditorClassIdentifier: 
  title: 
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 9f9aada79e4b64c4e9df2ba49fcc84f7, type: 2}
    dialogueLines:
    - line: 'Ser Advisor, one of our old windmills collapsed yesterday after a storm.
        We should invest in building a new one, or our food production will be reduced. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Of course - you have my full support in building a new one. '
        responseToChoice: 'Yes, thank you Ser. '
        consequences:
        - type: 0
          amount: -400
        - type: 6
          amount: 10
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'I understand, but at the moment we can not afford in investing
          in this. '
        responseToChoice: 'I see... I hope our food reserves are filled enough. '
        consequences:
        - type: 6
          amount: -15
        dailyChanges:
        - type: 1
          amount: -3
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
