  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: Dia_Peasants_SicknessSpreading
  m_EditorClassIdentifier: 
  title: 
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 9f9aada79e4b64c4e9df2ba49fcc84f7, type: 2}
    dialogueLines:
    - line: 'Ser Advisor, many people of ours have become sick and are barely able
        to move. It seems like more and more are catching the same thing. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'I will ask the royal doctor to look into it. '
        responseToChoice: 'Oh my, thank you so much. '
        consequences:
        - type: 5
          amount: -5
        - type: 6
          amount: 10
        dailyChanges: []
        receivingVaribale: {fileID: 11400000, guid: 4ba7a32ef204f474db541f08140a92b8, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: Quarantine anyone sick - we should not let this go uncontrolled.
        responseToChoice: 'I will see to it my people stay at home. '
        consequences:
        - type: 5
          amount: -5
        - type: 3
          amount: -20
        dailyChanges:
        - type: 1
          amount: -1
        receivingVaribale: {fileID: 11400000, guid: c02c0788318b4334ab9bd8679991984b, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: The Kingdom is in dire need of your work - the sick will need
          to push through.
        responseToChoice: I fear that will kill them.
        consequences:
        - type: 5
          amount: -15
        - type: 6
          amount: -15
        dailyChanges:
        - type: 1
          amount: 1
        receivingVaribale: {fileID: 11400000, guid: 0d28288e950672f4791894eb4434838c, type: 2}
      isFinalLine: 0
      nextSpeakerID: 0
