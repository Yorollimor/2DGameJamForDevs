  title: 
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 9f9aada79e4b64c4e9df2ba49fcc84f7, type: 2}
    dialogueLines:
    - line: 'Ser Advisor, this morning a family came to me and told be of an accident
        in the fields involving one of their children. They kindly ask for medical
        supplies so they can help their child. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Of course - I will arrange that a doctor will visit you. '
        responseToChoice: My thanks, and the family's.
        consequences:
        - type: 6
          amount: 10
        - type: 3
          amount: -15
        - type: 0
          amount: -10
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: Children are tough - it will be fine and become more careful
          afterwards.
        responseToChoice: I hope so. I will relay the message.
        consequences:
        - type: 6
          amount: -10
        - type: 5
          amount: -10
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
