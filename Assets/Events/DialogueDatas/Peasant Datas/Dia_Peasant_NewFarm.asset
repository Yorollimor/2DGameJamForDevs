  title: 
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 9f9aada79e4b64c4e9df2ba49fcc84f7, type: 2}
    dialogueLines:
    - line: 'Good day, Ser Advisor. We have seen that our food production can''t
        keep up with the stomachs to fill, and would like to ask for aid in building
        a new farm for cattle and such. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'A new farm sounds helpful. Get right to it. '
        responseToChoice: 'Yes, thank you Ser. '
        consequences:
        - type: 0
          amount: -500
        - type: 6
          amount: 15
        dailyChanges:
        - type: 1
          amount: 5
        receivingVaribale: {fileID: 11400000, guid: 023f7f6acf341a1468a26326654e71e3, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'While I appreciate the idea, the kingdom does not have the funds
          for it right now. '
        responseToChoice: 'I see.. that is unfortunate. '
        consequences:
        - type: 6
          amount: -10
        dailyChanges:
        - type: 1
          amount: -1
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
