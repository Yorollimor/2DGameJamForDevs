%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: Dia_Peasant_NewTools
  m_EditorClassIdentifier: 
  title: 
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 9f9aada79e4b64c4e9df2ba49fcc84f7, type: 2}
    dialogueLines:
    - line: 'Ser, recently many of our farmers sent me word that their tools for
        plucking the fields and cutting the harvest are old and need to be renewed.
        Do you think you can help us with that? '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: Farmers need proper tools to feed the kingdom - we will renew
          what they need.
        responseToChoice: 'That will be appreciated. '
        consequences:
        - type: 6
          amount: 10
        - type: 0
          amount: -150
        dailyChanges:
        - type: 1
          amount: 1
        receivingVaribale: {fileID: 11400000, guid: f171ce0a60902f4479e37333f71da85b, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'I have seen the tools you use - the kingdoms I visited before
          had more refined ones. I will see to it that you get modern tools. '
        responseToChoice: Oh, that would be a joy, thank you, Ser!
        consequences:
        - type: 6
          amount: 15
        - type: 0
          amount: -350
        dailyChanges:
        - type: 1
          amount: 2
        receivingVaribale: {fileID: 11400000, guid: f171ce0a60902f4479e37333f71da85b, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Our farmers will need to take care of their tools - we can not
          afford to invest in new ones right now. '
        responseToChoice: 'That is a shame, but I will relay your message. '
        consequences:
        - type: 6
          amount: -10
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
