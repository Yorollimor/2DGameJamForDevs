MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: Dia_Doctor_royal court sick
  m_EditorClassIdentifier: 
  title: Royal court shows signs of sickness, people die
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 1ac0a97e9935a5844bca54735b28090f, type: 2}
    dialogueLines:
    - line: The sickness! It spread to the court and I got a report saying that people
        started to die because of it. This could be a plague infection!
      choices: []
      isFinalLine: 0
      nextSpeakerID: 0
    - line: If we do not want the royal court, including you, me, and the King, to
        die we need to quarantine everyone inside the castle - by force if necessary!
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: Do it, get everyone inside the castle locked up and give them
          whatever medicine we have that could help or that you can make
        responseToChoice: 'I will make haste. May the favor of god be with us. '
        consequences:
        - type: 0
          amount: -450
        - type: 1
          amount: -15
        - type: 3
          amount: -100
        dailyChanges:
        - type: 3
          amount: -10
        - type: 2
          amount: -3
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'For an undertaking like this we need tremendous funds - which
          the kingdom does not have. Protect the king at all costs. '
        responseToChoice: 'By god, we are doomed. '
        consequences:
        - type: 5
          amount: -35
        - type: 1
          amount: -35
        dailyChanges:
        - type: 3
          amount: -15
        - type: 2
          amount: -5
        receivingVaribale: {fileID: 11400000, guid: d6130b7a63dd67441b845c53a99cd056, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'At this point, we have to quarantine everyone - inside and outside
          the castlewalls. Take whatever is needed for that. '
        responseToChoice: 'Understood - I will save as many as I can. '
        consequences:
        - type: 6
          amount: 30
        - type: 0
          amount: -800
        - type: 3
          amount: -350
        dailyChanges:
        - type: 3
          amount: -3
        - type: 2
          amount: -1
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
