  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: Dia_Doctor_QuestionableMedicine
  m_EditorClassIdentifier: 
  title: 
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 1ac0a97e9935a5844bca54735b28090f, type: 2}
    dialogueLines:
    - line: 'Advisor, some medicine that I am not too sure about is circulating -
        most likely sold by foreign doctors or merchants. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Why do you not trust it? '
        responseToChoice: It promises too much.
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
    - line: People say it cures their headaches and backaches, makes their cuts from
        work accidents heal quicker. No medicine I know of can do that much - and
        apparently more.
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: I understand, and I trust your judgement. Declare a ban on it
          and confiscate it all.
        responseToChoice: I will see to it personally.
        consequences:
        - type: 5
          amount: 15
        - type: 6
          amount: -25
        dailyChanges: []
        receivingVaribale: {fileID: 11400000, guid: 707b86b4fb5b49b409587d02e388155b, type: 2}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: If it helps the people, let them have it - who are we to rob
          them off their beliefs and pain reliefs?
        responseToChoice: I see... if you say so.
        consequences:
        - type: 5
          amount: 15
        dailyChanges: []
        receivingVaribale: {fileID: 11400000, guid: d0ca25f447134aa4793d5d8ccff851fd, type: 2}
      isFinalLine: 0
      nextSpeakerID: 0
