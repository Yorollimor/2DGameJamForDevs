  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: Dia_Doctor_Pregnant
  m_EditorClassIdentifier: 
  title: King Pregnant
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 1ac0a97e9935a5844bca54735b28090f, type: 2}
    dialogueLines:
    - line: 'Whatever I am going to tell you now is not to leave this room, understood? '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Sure. '
        responseToChoice: 'You better stay true to your word. '
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'The King is pregnant. Which is not terrible in itself as the kingdom
        needs an heir - but the child is a bastard and would ruin the reputation
        and authority of the King and kingdom. '
      choices: []
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'I would advise to ... encourage the King''s body to lose the child,
        but the things I need for it are costly. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: I think investing in getting rid of the child before it is born
          is the best for the kingdom. Take what you need.
        responseToChoice: 'I will. '
        consequences:
        - type: 0
          amount: -25
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: Let the King have his child - but he has to give it away anonymiously
          and we need to dispose of the other parent.
        responseToChoice: 'I suppose that could work as well. '
        consequences:
        - type: 6
          amount: -10
        - type: 4
          amount: -1
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
