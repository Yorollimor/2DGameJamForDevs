  title: Sick Nobles
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 1ac0a97e9935a5844bca54735b28090f, type: 2}
    dialogueLines:
    - line: Advisor, some nobles reported they feel weak and are with headaches.
        They ask for some extra food and drinks to be brought to their chambers.
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: Sure - we can spare some extra meals for them.
        responseToChoice: I will order it.
        consequences:
        - type: 5
          amount: -10
        - type: 3
          amount: -25
        - type: 1
          amount: 15
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: They will not die because of feeling tired and head pains - I
          can not allow for resources to be used for that.
        responseToChoice: I see - I think that is reasonable to do.
        consequences:
        - type: 5
          amount: -15
        - type: 1
          amount: -10
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
