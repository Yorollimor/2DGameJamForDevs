  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: Dia_Doctor_MinorCourtSickness
  m_EditorClassIdentifier: 
  title: Minor Sickness at court
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 1ac0a97e9935a5844bca54735b28090f, type: 2}
    dialogueLines:
    - line: 'Advisor, a terrible sickness is spreading among the court. We are worried
        it might reach the King - or any actual important person. '
      choices: []
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'We don''t know that to do. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Quarantine the sick to their chambers. '
        responseToChoice: 'I hope that is good enough. '
        consequences:
        - type: 1
          amount: -5
        dailyChanges:
        - type: 2
          amount: -2
        receivingVaribale: {fileID: 0}
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Buy enough medicine for them all - the gold reserves are at
          your disposal. '
        responseToChoice: 'Yes, I will get right to it. '
        consequences:
        - type: 0
          amount: -50
        - type: 1
          amount: 10
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 1
      nextSpeakerID: -1
