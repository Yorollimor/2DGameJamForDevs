  title: Introduction General Hatkick
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 5a6f24257be70fb4faf4193faac70975, type: 2}
    dialogueLines:
    - line: 'I wanted to introduce myself. I am the General of the army. '
      choices: []
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'I go by the name Hatkick. '
      choices:
      - choiceText: 'Good to meet you, come to me if anything comes up. '
        responseToChoice: 'If it benefits the security of the Kingdom and people,
          surely. '
        consequences: []
        dailyChanges: []
      - choiceText: 'I am not fond of the military, but come to me when it must be. '
        responseToChoice: 'Not too fond of strangers either, but the King''s orders
          are absolute. '
        consequences: []
        dailyChanges: []
      isFinalLine: 1
      nextSpeakerID: -1
