%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c0dc09dbaa30e694681d8e3582c8800f, type: 3}
  m_Name: Tutorial
  m_EditorClassIdentifier: 
  title: Tutorial
  speakingCharacters:
  - speaker: {fileID: 11400000, guid: 6f74c587975259d4f9962efdb1c258ff, type: 2}
    dialogueLines:
    - line: Advisor, good to see you finally in your working chambers. I know I asked
        you to come from a far-away land, but I was getting unsure you would ever
        arrive!
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Glad to be here, your Majesty. '
        responseToChoice: I hope you will bring prosperity to my kingdom just like
          you did with those others from your lands.
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'In any case, I asked my royal court to come see you and see your advice
        as my words - I ask you to not make me regret giving you that power. '
      choices: []
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'Just keep my kingdom''s economy balanced for the next 30 sunrises and
        you shall receive your payment and are free to go. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: I will advise your people to the best of my ability - But I ask
          to bring help to the poor as well.
        responseToChoice: The peasants? Well, if that is needed for yours and therefore
          the Kingdom's success - sure.
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'You should know that my Kingdom is already in a somewhat fragile position
        - should we not be able to pay the costs for the decisions that need to be
        made, it will most likely crumble. '
      choices: []
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'Speaking of costs, that brings me to my next point: Taxes are gathered
        weekly so use my money wisely. Further, the farmers bring food every week,
        but, naturally, everyone eats daily. Make sure we have enough to last the
        week. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'So we weekly gain money and food, but food is used up daily,
          of course. Understood. '
        responseToChoice: Exactly.
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
    - line: 'Naturally, if through your decisions all of my people die, we run out
        of food, or worst - my safety is unsure, you will go down with my kingdom. '
      choices:
      - conditionToShow: {fileID: 0}
        conditionToHide: {fileID: 0}
        choiceText: 'Yes, your Majesty. '
        responseToChoice: Good. I will leave you to it then - bring posperity to
          my kingdom and people, and keep us safe.
        consequences: []
        dailyChanges: []
        receivingVaribale: {fileID: 0}
      isFinalLine: 0
      nextSpeakerID: 0
