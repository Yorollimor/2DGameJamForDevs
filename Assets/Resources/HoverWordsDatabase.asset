%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 81b802fe0b6efa942bd14e1046c58f2c, type: 3}
  m_Name: HoverWordsDatabase
  m_EditorClassIdentifier: Assembly-CSharp::HoverableWordsDatabase
  primaryResourceColor: {r: 0.90588236, g: 0.74509805, b: 0.101960786, a: 1}
  secondaryResourceColor: {r: 0.5058824, g: 0.7647059, b: 0.84313726, a: 1}
  databaseEntries:
  - word: Gold
    word_variants:
    - Coin
    - Coins
    - Money
    description: Probably the most important resource. The kingdom can go into debt
      once, but then has to earn it's way out of it to spend gold again.
    richTextOpenTag: <color=PrimaryResource>
    richTextCloseTag: </color>
  - word: Tax
    word_variants:
    - taxes
    description: The main income of the kingdom. It gets collected weekly, but the
      actual amount depends on the loyalty of people and the King's authority over
      them.
    richTextOpenTag: <color=SecondaryResource>
    richTextCloseTag: </color>
  - word: Food
    word_variants:
    - taxes
    description: A daily necessity to keep the people alive. The peasants produce
      it weekly.
    richTextOpenTag: <color=PrimaryResource>
    richTextCloseTag: </color>
  - word: Population
    word_variants:
    - peasants
    description: The peasant people essential to the kingdom. They need food and
      produce it, and is heavily influenced weekly by the current health and net-food
      production.
    richTextOpenTag: <color=PrimaryResource>
    richTextCloseTag: </color>
  - word: Soldier
    word_variants:
    - soldiers
    description: The defenders of the kingdom. They enforce the law, protect from
      outside forces, and help out with anything security related.
    richTextOpenTag: <color=PrimaryResource>
    richTextCloseTag: </color>
  - word: Health
    word_variants:
    - healthy
    description: 'An indicator of how healthy the kingdom is. The less healthy, the
      more sickness will spread and less people will be born or settle down here.

      Weekly,
      if the kingdom is healthy enough, it boosts the population growth - if it is
      in bad shape, it reduces it.'
    richTextOpenTag: <color=PrimaryResource>
    richTextCloseTag: </color>
  - word: Loyalty
    word_variants:
    - LoyaltyToKing
    description: How loyal the people are - generally, how much the King is liked.
      This influences the likelyhood of taxes being paid and other events.
    richTextOpenTag: <color=PrimaryResource>
    richTextCloseTag: </color>
  - word: Authority
    word_variants:
    - LoyaltyToKing
    description: The firm grip the King has over their people - how much they respect
      (or fear) the King. Has an influence on taxes being paid and other related
      events.
    richTextOpenTag: <color=PrimaryResource>
    richTextCloseTag: </color>
  - word: Venna
    word_variants:
    - LoyaltyToKing
    description: A neighboring kingdom. Rarely interacted with, little information
      is known about it.
    richTextOpenTag: <color=SecondaryResource>
    richTextCloseTag: </color>
  - word: Linza
    word_variants:
    - LoyaltyToKing
    description: A neighboring kingdom. A trade-focused one, but the outcome of their
      trades is often unknown beforehand.
    richTextOpenTag: <color=SecondaryResource>
    richTextCloseTag: </color>
